            "https://whatsapp.com/channel/0029VbDQIGtDuMRjUa47Jl20\n\n" +
            BOT_NAME +
            "\n╰────────────────╯";

          let sent = null;

          try {
            const imageUrl = await sock.profilePictureUrl(user, "image");

            if (imageUrl) {
              const response = await fetch(imageUrl);

              if (response.ok) {
